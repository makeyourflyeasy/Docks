rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Security & Auth Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'makeyourflyeasy@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Connection health ping
    match /test/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Logistics & Customs Cases
    match /cases/{caseId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Registered Clients Directory
    match /clients/{clientId} {
      allow read, write: if true;
    }

    // Financial Ledger Transactions
    match /finances/{financeId} {
      allow read, write: if true;
    }
    match /finance/{financeId} {
      allow read, write: if true;
    }

    // Transport Vehicles & Fleet
    match /vehicles/{vehicleId} {
      allow read, write: if true;
    }

    // Registered App Users
    match /users/{userId} {
      allow read, write: if true;
    }

    // Action Center Notifications & Tasks
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // Company Settings & Profile
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Registered Utility & Office Vendors
    match /vendors/{vendorId} {
      allow read, write: if true;
    }

    // Recurring Monthly Templates
    match /recurring_templates/{templateId} {
      allow read, write: if true;
    }

    // Staff Ledgers
    match /staff_ledgers/{ledgerId} {
      allow read, write: if true;
    }

    // Destination Staff & Port Officers
    match /destination_staff/{staffId} {
      allow read, write: if true;
    }

    // Activity Logs
    match /activity_logs/{logId} {
      allow read, write: if true;
    }

    // Company Branding
    match /branding/{brandingId} {
      allow read, write: if true;
    }
  }
}
